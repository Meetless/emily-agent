# Gemini model access (ADK reads these). Use a Gemini API key for the simplest
# setup, or switch to Vertex AI with GOOGLE_GENAI_USE_VERTEXAI=TRUE + a project.
GOOGLE_API_KEY=your-gemini-api-key
GOOGLE_GENAI_USE_VERTEXAI=FALSE

# The Gemini model Emily reasons with (must be >= 3.5 for the hackathon).
EMILY_MODEL=gemini-3.5-flash

# Meetless connection (the MCP server Emily drives is spawned with these).
# Point at your Meetless control + intel and a workspace you can drive.
MEETLESS_WORKSPACE_ID=ws_your_demo_workspace
MEETLESS_CONTROL_TOKEN=your-workspace-internal-api-key
MEETLESS_BACKEND_URL=http://127.0.0.1:3006
MEETLESS_INTEL_URL=http://127.0.0.1:8100
# The workspace user Emily reviews proposals as (an operator seat).
MEETLESS_OPERATOR_USER_ID=wu_owner_...

# The Meetless MCP server command. Defaults to `node <monorepo>/.../mcp/dist/server.js`.
# In a container, install @meetless/mcp and set these to `npx @meetless/mcp`.
# MEETLESS_MCP_COMMAND=node
# MEETLESS_MCP_SERVER=/abs/path/to/meetless-cli/packages/mcp/dist/server.js
